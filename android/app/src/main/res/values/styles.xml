<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- The launch window, shown while the process starts and until Flutter
         draws its first frame: the launch drawable (the BG token of the
         phone's theme, with the logo), and system bars in the same colour
         with icons that read on it.

         Colours and bools switch with the phone's dark mode through
         values-night. Keep styles out of values-night: it outranks
         values-v31, so a night LaunchTheme would hide the Android 12+ splash
         settings. -->
    <style name="OsdLaunchBase" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@color/osd_launch_background</item>
        <item name="android:navigationBarColor">@color/osd_launch_navigation_bar</item>
        <item name="android:windowLightStatusBar">@bool/osd_launch_light_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/osd_launch_light_bars</item>
    </style>

    <!-- Theme applied to the Android Window while the process is starting.
         values-v31 adds the Android 12+ splash screen settings. -->
    <style name="LaunchTheme" parent="OsdLaunchBase" />

    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running.
         
         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/osd_launch_background</item>
    </style>
</resources>
